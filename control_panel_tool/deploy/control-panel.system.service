[Unit]
Description=Server Control Panel (system-wide service)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/opt/server_control_panel
ExecStart=/opt/server_control_panel/.venv/bin/python dashboard.py
Environment=PANEL_HOST=0.0.0.0
Environment=PORT=5050
EnvironmentFile=-/etc/server-control-panel.env
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
